<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Modern Android blocks plain HTTP network calls by default (targetSdk 28+), separately from
      the WebView's own "mixed content" check. Our Spring Boot backend has no TLS certificate in
      local development, so we scope a cleartext exception to just the known dev hosts instead of
      allowing cleartext traffic app-wide.
      - 10.0.2.2: the Android emulator's alias for the host machine's localhost.
      - Replace/extend the LAN IP below with your dev machine's current Wi-Fi address when testing
        on a physical device (ipconfig/ifconfig) — it changes if you switch networks.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.100.21</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
